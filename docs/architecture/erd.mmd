%%
%% Reading the attribute lines:
%%   type name [PK|FK|UK] "notes"
%%   NOT NULL and CHECK detail lives in database-schema.md section 4; the note here is a pointer.
%%   "org+id target" marks the UNIQUE (organization_id, id) keys that exist so child tables can
%%   declare a composite same-organization foreign key.
%%
%% Relationship lines below: the first 14 are the AGREED relationships - 12 from the original schema
%% plus the 2 idempotency edges approved with U4. Their status is unchanged by the 2026-11-22 alignment.
%% The last 3 are the U12 provenance columns, adopted and approved by A10 (2026-11-22); they are labelled
%% "U12 approved by A10" and carry their F3-A/F3-B/F3-C resolution (2026-11-23). No other relationship
%% line is newly approved.
%%
%% Names that must not reappear: subscriptions, subscription_destinations, outbox_events,
%% destinations_snapshot, and the events.status column (removed by U36 - do not reintroduce it).
%% Also gone since U4: events.idempotency_key and events.dedupe_hash, which now live in
%% idempotency_records as idempotency_key and request_hash.

erDiagram
    users ||--o{ organization_members : "agreed many to many"
    organizations ||--o{ organization_members : "agreed many to many"
    organizations ||--o{ api_keys : "agreed one to many"
    organizations ||--o{ endpoints : "agreed one to many, soft deletable"
    organizations ||--o{ events : "agreed one to many"
    organizations ||--o{ organization_subscriptions : "agreed commercial plan record"
    organizations ||--o{ audit_logs : "agreed one to many"
    endpoints ||--o{ endpoint_subscriptions : "agreed routing rules"
    events ||--o{ deliveries : "agreed one to many"
    endpoints ||--o{ deliveries : "agreed one to many"
    deliveries ||--o{ delivery_attempts : "agreed one to many"
    deliveries ||--o{ outbox_messages : "agreed one to many, not one to one"
    organizations ||--o{ idempotency_records : "approved with U4, key scoped to org"
    events |o--o{ idempotency_records : "approved with U4, nullable event link"
    organizations ||--o{ delivery_retry_requests : "Phase 10, retry key scoped to org"
    deliveries ||--o{ delivery_retry_requests : "Phase 10, retry source"
    deliveries ||--o{ delivery_retry_requests : "Phase 10, retry new generation"
    deliveries |o--o{ deliveries : "Phase 10, retry lineage parent"
    users |o--o{ api_keys : "U12 approved by A10, creator; F3-A single-column SET NULL"
    api_keys |o--o{ events : "U12 approved by A10, provenance; F3-B composite SET NULL"
    endpoint_subscriptions |o--o{ deliveries : "U12 approved by A10, rule that matched; F3-C composite SET NULL"

    users {
        uuid id PK
        text email "not null, unique on lower email"
        text name "not null, max 100"
        text password_hash "null means no local password"
        timestamptz password_updated_at
        text status "not null, invited active disabled"
        boolean mfa_enabled "not null default false"
        timestamptz last_login_at
        timestamptz created_at "not null"
        timestamptz updated_at "not null"
    }

    organizations {
        uuid id PK "org+id target; also the U38 FOR NO KEY UPDATE lock anchor for the endpoint count"
        text name "not null"
        jsonb settings "not null, per tenant preferences"
        text status "not null, active suspended archived"
        timestamptz created_at "not null"
        timestamptz updated_at "not null"
    }

    organization_members {
        uuid id PK
        uuid organization_id "FK not null, cascade, org+id target"
        uuid user_id "FK not null, cascade"
        text role "not null, owner admin member viewer"
        uuid invited_by "FK nullable, set null"
        timestamptz joined_at "not null"
        timestamptz created_at "not null"
        timestamptz updated_at "not null"
    }

    api_keys {
        uuid id PK
        uuid organization_id "FK not null, cascade, org+id target"
        text name "not null, unique per org while live"
        text key_prefix "not null, unique, non secret lookup fragment"
        text secret_hash "not null, HASHED, never recoverable"
        text hash_algorithm "not null default argon2id"
        text scopes_array "text array, not null"
        timestamptz last_used_at
        timestamptz expires_at
        timestamptz revoked_at "null means live"
        uuid created_by_user_id "FK nullable, set null, U12 provenance adopted by A10"
        uuid revoked_by_user_id "FK nullable, U12 provenance adopted by A10"
        timestamptz created_at "not null"
        timestamptz updated_at "not null"
    }

    endpoints {
        uuid id PK
        uuid organization_id "FK not null, cascade, org+id target"
        text name "not null, unique per org where live"
        text description "nullable, max 500"
        text url "not null, https only CHECK"
        text secret_encrypted "not null, REVERSIBLE ciphertext of the signing secret; envelope/key-version format open (U6), copy-to-delivery per A8"
        text signing_scheme "not null default hmac_sha256"
        jsonb http_headers "not null"
        text status "not null, active paused"
        integer timeout_ms "not null, 250 to 30000"
        integer max_attempts "null means org default"
        timestamptz last_success_at
        timestamptz last_failure_at
        timestamptz created_at "not null"
        timestamptz updated_at "not null"
        timestamptz deleted_at "SOFT DELETE MARKER, null means live"
    }

    endpoint_subscriptions {
        uuid id PK "recorded in the snapshot as endpoint_subscription_id"
        uuid organization_id "FK not null, cascade, redundant by design"
        uuid endpoint_id "not null, composite FK to endpoints org id, CASCADE"
        text event_type "not null, UNIQUE with endpoint_id, EXACT MATCH ONLY no wildcards, U16 approved"
        boolean is_active "not null default true, retained as the routing-rule toggle, A10"
        timestamptz created_at "not null, append only join"
    }

    events {
        uuid id PK
        uuid organization_id "FK not null, cascade, org+id target"
        text type "not null, lowercase dotted"
        jsonb payload "not null, must be a JSON object (rev 14), size cap U17 still unset, value domain fixed by U46 plus guard G1 - see schema 4.7"
        integer destination_count "not null default 0, CHECK non negative, KEPT per U36; 0 means no endpoint matched and the event is still accepted"
        jsonb headers "allowlisted, credential free"
        uuid api_key_id "nullable, composite FK to api_keys org+id, SET NULL (api_key_id), F3-B provenance"
        inet source_ip
        timestamptz occurred_at "caller event time"
        timestamptz received_at "not null, retention clock"
        timestamptz expires_at "not null, end of delivery window"
        timestamptz created_at "not null"
        timestamptz updated_at "not null"
    }

    deliveries {
        uuid id PK "sent as X HookFlow Delivery Id"
        uuid organization_id "FK not null, cascade, org+id target"
        uuid event_id "not null, composite FK to events org id, CASCADE"
        uuid endpoint_id "not null, composite FK to endpoints org id, RESTRICT"
        uuid endpoint_subscription_id "nullable provenance pointer, composite FK to endpoint_subscriptions org+id, SET NULL (endpoint_subscription_id), F3-C; snapshot payload unchanged"
        text url "not null, SNAPSHOT COLUMN, destination URL as accepted, U33"
        jsonb http_headers "not null, SNAPSHOT COLUMN, headers as accepted, U33"
        text secret_encrypted "not null, SNAPSHOT COLUMN, encrypted secret as accepted, U33, copy-to-delivery per A8"
        text state "not null, pending retrying succeeded failed expired, SOURCE OF TRUTH for processing state per U36"
        integer dispatch_seq "not null, CHECK >= 1, initial 1 incremented per retry, no default, A2"
        integer attempt_count "not null"
        timestamptz next_attempt_at "business due-time authority, NULL once terminal; available_at is a derived relay gate, U8 and A3"
        timestamptz last_attempt_at
        integer last_response_status
        text last_error "truncated and scrubbed"
        smallint priority "not null default 0"
        timestamptz created_at "not null, retention clock"
        timestamptz updated_at "not null"
        timestamptz completed_at "not null only in terminal state"
        uuid dispatch_lease_token "nullable, C-2 worker fence, not an entity id, A1"
        timestamptz dispatch_lease_expires_at "nullable, paired with the token, no default, A1"
        integer generation "not null default 1, CHECK >= 1, 1 at accept, MAX+1 per manual retry, Phase 10"
        uuid parent_delivery_id "nullable only for generation 1, self composite FK to deliveries org+id RESTRICT, Phase 10"
    }

    delivery_attempts {
        uuid id PK
        uuid organization_id "FK not null, cascade"
        uuid delivery_id "not null, composite FK to deliveries org id, CASCADE"
        integer attempt_number "not null, UNIQUE with delivery_id"
        text request_method "not null default POST"
        text request_url "not null"
        jsonb request_headers "not null, secrets redacted"
        integer response_status
        jsonb response_headers "Retry-After preserved"
        text response_body_snippet "truncated"
        text outcome "not null, completion only, success retryable_failure terminal_failure, A4"
        text error_class "timeout connect tls dns http_status internal"
        text error_message "truncated"
        integer duration_ms
        timestamptz started_at "not null, observed start supplied explicitly, retention clock"
        timestamptz finished_at "not null, completion time, A4"
    }

    outbox_messages {
        uuid id PK
        uuid organization_id "FK not null, cascade"
        uuid delivery_id "not null, composite FK to deliveries org id, no unique constraint; UNIQUE (delivery_id, sequence) governs retry identity"
        integer sequence "not null, CHECK >= 1, no default, matches deliveries.dispatch_seq, A2"
        text kind "not null, delivery dispatch, delivery retry"
        text topic "not null, amqp routing target"
        jsonb payload "not null, dispatch intent not body"
        jsonb headers
        text status "not null, pending publishing published failed"
        integer attempts "not null, per-cycle claim count, T1 increments, Sweep re-arm resets, B1"
        timestamptz available_at "not null, no default, derived relay gate by the A3 formulas"
        timestamptz locked_at "persisted publisher lease start; expiry = locked_at + configured L, B1"
        text locked_by "publisher instance id"
        uuid lease_token "nullable, fresh per-claim fence, cleared on leaving publishing, unique uq_outbox_lease_token, B1/F8"
        timestamptz published_at
        text last_error "truncated"
        timestamptz created_at "not null"
        timestamptz updated_at "not null"
    }

    organization_subscriptions {
        uuid id PK
        uuid organization_id "FK not null, cascade, org+id target"
        text plan "not null, free pro enterprise, NOT on organizations"
        text status "not null, trialing active past_due canceled incomplete"
        timestamptz current_period_start
        timestamptz current_period_end "must be after period start"
        timestamptz trial_ends_at
        timestamptz canceled_at
        timestamptz created_at "not null"
        timestamptz updated_at "not null"
    }

    audit_logs {
        uuid id PK "application-generated UUIDv7, no DEFAULT (A9); the U20 register row is unchanged"
        uuid organization_id "FK not null, CASCADE, per agreed one to many; organization-scoped rows only in V1, U9 and A9"
        text actor_type "not null, user api_key system service"
        uuid actor_id "polymorphic, intentionally no FK"
        text action "not null, endpoint created style"
        text target_type
        uuid target_id
        inet ip
        text user_agent
        jsonb metadata "not null, never secrets or payloads"
        timestamptz occurred_at "not null, append only table"
    }

    idempotency_records {
        uuid id PK
        uuid organization_id "FK not null, cascade, the scope of the key per U4"
        text idempotency_key "not null, UNIQUE with organization_id, REQUIRED header value"
        bytea request_hash "not null, exactly 32 bytes, SHA-256 of the RFC 8785 JCS form of event_type plus payload, U41 approved"
        text hash_algorithm "not null default sha256, pinned to that one value by chk_idem_hash_alg, U41"
        uuid event_id "nullable only in flight, never NULL committed - trg_idem_linked, composite FK to events org id CASCADE, U44 approved"
        timestamptz created_at "not null, start of the 72 hour window"
        timestamptz expires_at "not null after created_at, key reusable once passed regardless of cleanup, swept by worker, U4 and U43 approved"
    }

    delivery_retry_requests {
        uuid id PK
        uuid organization_id "FK not null, cascade, the scope of the retry key"
        text idempotency_key "not null, 1-200, UNIQUE with organization_id"
        bytea request_hash "not null, exactly 32 bytes, SHA-256 of hookflow.delivery.retry.v1 prefix plus source delivery id"
        uuid source_delivery_id "not null, composite FK to deliveries org id CASCADE, terminal failed source"
        uuid new_delivery_id "not null, composite FK to deliveries org id CASCADE, distinct from source"
        timestamptz created_at "not null, start of the 72 hour window"
        timestamptz expires_at "not null after created_at, key reusable once passed, reclaimed lazily"
    }
