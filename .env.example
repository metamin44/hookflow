# PostgreSQL (required)
HOOKFLOW_DB_NAME=hookflow_dev
HOOKFLOW_DB_USER=hookflow
HOOKFLOW_DB_PASSWORD=replace-with-a-random-local-password
HOOKFLOW_DB_HOST=127.0.0.1
HOOKFLOW_DB_PORT=5433
HOOKFLOW_DB_SSLMODE=disable

# RabbitMQ (required). URL-encode the password if it contains URI reserved characters.
HOOKFLOW_RABBITMQ_USER=hookflow
HOOKFLOW_RABBITMQ_PASSWORD=replace-with-a-different-random-local-password
HOOKFLOW_RABBITMQ_URI=amqp://hookflow:replace-with-a-different-random-local-password@127.0.0.1:5673/
HOOKFLOW_RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15673
HOOKFLOW_RABBITMQ_AMQP_PORT=5673
HOOKFLOW_RABBITMQ_MANAGEMENT_PORT=15673
HOOKFLOW_RABBITMQ_HEARTBEAT=10s
HOOKFLOW_RABBITMQ_CONNECT_TIMEOUT=5s
HOOKFLOW_RABBITMQ_RECONNECT_MIN_BACKOFF=500ms
HOOKFLOW_RABBITMQ_RECONNECT_MAX_BACKOFF=10s

# Publisher D3 defaults
HOOKFLOW_PUBLISHER_BATCH_SIZE=200
HOOKFLOW_PUBLISHER_MAX_CLAIMS=5
HOOKFLOW_PUBLISHER_LEASE_DURATION=30s
HOOKFLOW_PUBLISHER_POLL_INTERVAL=500ms
HOOKFLOW_PUBLISHER_REAP_INTERVAL=10s
HOOKFLOW_PUBLISHER_BACKOFF_BASE=2s
HOOKFLOW_PUBLISHER_BACKOFF_CAP=60s
HOOKFLOW_PUBLISHER_BACKOFF_MIN=100ms
HOOKFLOW_PUBLISHER_CONFIRM_TIMEOUT=5s

# Worker D4 defaults
HOOKFLOW_WORKER_LEASE_DURATION=30s
HOOKFLOW_WORKER_HTTP_DEADLINE=10s
HOOKFLOW_WORKER_HANDSHAKE_BUDGET=2s
HOOKFLOW_WORKER_POST_PROCESS_BUDGET=3s
HOOKFLOW_WORKER_SHUTDOWN_RESERVE=10s
HOOKFLOW_WORKER_SECRET_RESOLUTION_BUDGET=2s
HOOKFLOW_WORKER_CONCURRENCY=24
HOOKFLOW_WORKER_PREFETCH=24
HOOKFLOW_WORKER_POOL_SIZE=30
HOOKFLOW_WORKER_MAX_ATTEMPTS=8
HOOKFLOW_WORKER_RETRY_HORIZON=12h
HOOKFLOW_WORKER_DECRYPT_FAILURE_PACING=30s
HOOKFLOW_WORKER_RESPONSE_BODY_LIMIT=65536

# Recovery D5 defaults
HOOKFLOW_RECOVERY_CADENCE=60s
HOOKFLOW_RECOVERY_TOTAL_DURATION=45s
HOOKFLOW_RECOVERY_EXPIRE_MAX_CANDIDATES=500
HOOKFLOW_RECOVERY_EXPIRE_MAX_DURATION=12s
HOOKFLOW_RECOVERY_REPAIR_MAX_CANDIDATES=250
HOOKFLOW_RECOVERY_REPAIR_MAX_DURATION=10s
HOOKFLOW_RECOVERY_REARM_MAX_CANDIDATES=250
HOOKFLOW_RECOVERY_REARM_MAX_DURATION=10s
HOOKFLOW_RECOVERY_STALE_MAX_CANDIDATES=100
HOOKFLOW_RECOVERY_STALE_MAX_DURATION=8s
HOOKFLOW_RECOVERY_STALE_PUBLISHED_AFTER=5m

# Optional process-local metrics listener. Empty disables it.
HOOKFLOW_METRICS_ADDR=

# Management API limits (cmd/api). Default is 100 active endpoints per
# organization when unset. A present empty or whitespace-only value is invalid.
HOOKFLOW_MAX_ACTIVE_ENDPOINTS_PER_ORG=100

# Delivery security (development only). Read by cmd/api (endpoint secret
# rotation) and cmd/worker (delivery decryption and signing); the Publisher,
# migrator, apikey CLI and dev-keyring do not load them. Production fails
# closed because this build has no production KEK provider.
HOOKFLOW_DEPLOYMENT_MODE=development
# Explicit development opt-in: ONLY snapshots whose stored secret is empty may
# be sent unsigned. Non-empty secrets must decrypt and sign; a failure never
# falls back to unsigned. Production or an unknown mode fails closed.
HOOKFLOW_ALLOW_UNSIGNED_DELIVERY=true
HOOKFLOW_SECRET_PROVIDER=file
# Run scripts/dev-keyring.sh ensure and paste the absolute native path it
# prints. The keyring must stay outside this repository. Leaving it empty
# makes the Worker fail closed at startup.
HOOKFLOW_SECRET_KEYRING_PATH=
HOOKFLOW_SECRET_CURRENT_KID=kek-1
HOOKFLOW_SECRET_ALLOWED_KIDS=kek-1
HOOKFLOW_SECRET_ALLOWED_PROVIDERS=file
